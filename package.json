{
  "name": "elkousy-1000-templates",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node arabity/scripts/build.mjs && node masaref/scripts/build.mjs && next build",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts && node --test arabity/tests/*.test.mjs && node --test masaref/tests/*.test.mjs",
    "lint": "next lint",
    "arabity": "node arabity/scripts/serve.mjs",
    "arabity:build": "node arabity/scripts/build.mjs",
    "masaref": "node masaref/scripts/serve.mjs",
    "masaref:build": "node masaref/scripts/build.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "next": "^14.2.23",
    "nodemailer": "^9.0.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
