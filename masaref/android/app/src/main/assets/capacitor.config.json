{
	"appId": "com.masaref.spendcontrol",
	"appName": "مصارف",
	"webDir": "dist",
	"server": {
		"androidScheme": "https"
	},
	"android": {
		"backgroundColor": "#F6F3EC",
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false
	},
	"plugins": {
		"Keyboard": {
			"resize": "body",
			"resizeOnFullScreen": true
		},
		"StatusBar": {
			"style": "LIGHT",
			"backgroundColor": "#F6F3EC"
		}
	}
}
